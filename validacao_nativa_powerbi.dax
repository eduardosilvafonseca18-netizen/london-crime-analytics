EVALUATE ROW("FatoRows", COUNTROWS('FatoCrimes'), "TotalCrimes", [Crimes], "Crimes2016", [Crimes referência], "Crimes2015", [Crimes referência anterior], "Variacao2016", [Variação referência %], "Violencia2016", [Violência referência], "DistritosPrioritarios", [Distritos prioritários], "Haringey2016", CALCULATE([Crimes referência], TREATAS({"Haringey"}, 'DimBairro'[bairro])), "NullKeys", COALESCE(COUNTROWS(FILTER('FatoCrimes', ISBLANK('FatoCrimes'[data_mes]) || ISBLANK('FatoCrimes'[bairro_id]) || ISBLANK('FatoCrimes'[crime_id]))), 0), "DuplicateGrain", COUNTROWS('FatoCrimes') - COUNTROWS(SUMMARIZE('FatoCrimes', 'FatoCrimes'[data_mes], 'FatoCrimes'[bairro_id], 'FatoCrimes'[crime_id])), "NegativeValues", COALESCE(CALCULATE(COUNTROWS('FatoCrimes'), 'FatoCrimes'[quantidade_crimes] < 0), 0), "NaoPrioritario", CALCULATE([Distritos prioritários], TREATAS({"Bromley"}, 'DimBairro'[bairro])))
