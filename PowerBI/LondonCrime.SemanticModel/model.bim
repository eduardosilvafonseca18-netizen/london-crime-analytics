            "summarizeBy": "none"
          }
        ],
        "description": "Uma linha por mês, borough e categoria. SUM(crimes) corresponde a SUM(value) da origem.",
        "lineageTag": "83ab2fdf-752f-4708-b901-8591cf9a2d74",
        "measures": [
          {
            "name": "Crimes",
            "displayFolder": "Indicadores",
            "expression": "SUM('FatoCrimes'[quantidade_crimes])",
            "formatString": "#,0",
            "lineageTag": "2dec52f6-a371-4e6e-845e-7f052fcade8d"
          },
          {
            "name": "Crimes ano anterior",
            "displayFolder": "Comparações",
            "expression": "CALCULATE([Crimes], DATEADD('DimData'[data], -1, YEAR))",
            "formatString": "#,0",
            "lineageTag": "d048b2d6-4f1c-4bee-96c1-437d12dd0d7d"
          },
          {
            "name": "Variação absoluta",
            "displayFolder": "Comparações",
            "expression": [
              "VAR Anterior = [Crimes ano anterior]",
              "RETURN IF(NOT ISBLANK(Anterior), [Crimes] - Anterior)"
            ],
            "formatString": "+#,0;-#,0;0",
            "lineageTag": "b9cbc562-782f-4b9a-a254-b7bd32b71000"
          },
          {
            "name": "Variação anual %",
            "displayFolder": "Comparações",
            "expression": [
              "VAR Anterior = [Crimes ano anterior]",
              "RETURN IF(Anterior > 0, DIVIDE([Crimes] - Anterior, Anterior))"
            ],
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "53d44dea-086d-4e3d-b46b-6024185c96d4"
          },
          {
            "name": "Violência contra a pessoa",
            "displayFolder": "Indicadores",
            "expression": "CALCULATE([Crimes], REMOVEFILTERS('DimCrime'), 'DimCrime'[violencia_pessoa] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "bbb52d13-c1ec-48ed-92c6-02306dae5dad"
          },
          {
            "name": "Crimes referência",
            "displayFolder": "Referência",
            "expression": "CALCULATE([Crimes], REMOVEFILTERS('DimData'), 'DimData'[ano] = 2016)",
            "formatString": "#,0",
            "lineageTag": "242627e7-7a05-4018-9313-e17295080ec9"
          },
          {
            "name": "Crimes referência anterior",
            "displayFolder": "Referência",
            "expression": "CALCULATE([Crimes], REMOVEFILTERS('DimData'), 'DimData'[ano] = 2015)",
            "formatString": "#,0",
            "lineageTag": "f653141c-107c-4dbe-b7e5-6571150b95d2"
          },
          {
            "name": "Variação referência %",
            "displayFolder": "Referência",
            "expression": "DIVIDE([Crimes referência] - [Crimes referência anterior], [Crimes referência anterior])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "b0a6fd7c-bb22-4a71-9ffb-fb78108f8e2e"
          },
          {
            "name": "Violência referência",
            "displayFolder": "Referência",
            "expression": "CALCULATE([Violência contra a pessoa], REMOVEFILTERS('DimData'), 'DimData'[ano] = 2016)",
            "formatString": "#,0",
            "lineageTag": "593e2673-f294-46c2-a806-db5dc8332903"
          },
          {
            "name": "Crimes 2011",
            "displayFolder": "Referência",
            "expression": "CALCULATE([Crimes], REMOVEFILTERS('DimData'), 'DimData'[ano] = 2011)",
            "formatString": "#,0",
            "lineageTag": "d6dd832e-7c22-4729-be04-fead4933a419"
          },
          {
            "name": "Variação 2011 a 2016 %",
            "displayFolder": "Referência",
            "expression": "DIVIDE([Crimes referência] - [Crimes 2011], [Crimes 2011])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "9a7fad2a-d3d8-4aa7-b8b0-462ce1dcf86b"
          },
          {
            "name": "Média mensal 2011 a 2016",
            "displayFolder": "Sazonalidade",
            "expression": "AVERAGEX(VALUES('DimData'[ano]), [Crimes])",
            "formatString": "#,0",
            "lineageTag": "c4d4f89b-1843-48d7-b923-0b74c3550492"
          },
          {
            "name": "Distritos prioritários",
            "displayFolder": "Priorização",
            "expression": "COALESCE(CALCULATE(COUNTROWS('Prioridades'), KEEPFILTERS('Prioridades'[prioridade] = \"Priorizar prevenção\")), 0)",
            "formatString": "#,0",
            "lineageTag": "fff8a033-d3ab-41a4-ac96-fa4694b4f68e"
          },
          {
            "name": "Crimes prioridade",
            "displayFolder": "Priorização",
            "expression": "SUM('Prioridades'[crimes])",
            "formatString": "#,0",
            "lineageTag": "cc88ff92-fb36-4f1e-8500-a7cb2c1bf7f0"
          },
          {
            "name": "Aumento prioridade",
            "displayFolder": "Priorização",
            "expression": "SUM('Prioridades'[variacao_absoluta])",
            "formatString": "+#,0;-#,0;0",
            "lineageTag": "497313a6-f2e8-4d12-a9d0-31f5f920574a"
          },
          {
            "name": "Variação prioridade %",
            "displayFolder": "Priorização",
            "expression": "DIVIDE(SUM('Prioridades'[variacao_absoluta]), SUM('Prioridades'[crimes_anterior]))",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "1369828b-2d8b-48ad-9ba4-3cd4790b82a9"
          },
          {
            "name": "Crimes LSOA",
            "displayFolder": "Microáreas",
            "expression": "SUM('Hotspots'[crimes])",
            "formatString": "#,0",
            "lineageTag": "11e6841b-7b34-40bb-ba06-142faeea0124"
          },
          {
            "name": "Concentração LSOA %",
            "displayFolder": "Microáreas",
            "expression": "IF(HASONEVALUE('DimBairro'[bairro]), DIVIDE(SUM('Hotspots'[crimes]), MAX('Hotspots'[total_bairro])))",
            "formatString": "0.0%",
            "lineageTag": "01962459-7ae2-4178-bcbc-0c8a0dfe4ef3"
          },
          {
            "name": "Validações aprovadas",
            "displayFolder": "Qualidade",
            "expression": "CALCULATE(COUNTROWS('Validacoes'), 'Validacoes'[resultado] = \"OK\")",
            "formatString": "#,0",
            "lineageTag": "5cd78a8f-6d08-4199-90cd-6be91d0a9632"
          },
          {
            "name": "Registros da origem",
            "displayFolder": "Qualidade",
            "expression": "13490604",
            "formatString": "#,0",
            "lineageTag": "e17614c3-529f-4d35-9941-435d930b45b9"
          },
          {
            "name": "Crimes na origem",
            "displayFolder": "Qualidade",
            "expression": "6447758",
            "formatString": "#,0",
            "lineageTag": "bf26d26c-ee77-4a2b-bd19-5ac1ffc51c77"
          },
          {
            "name": "Qualidade da comparação",
            "displayFolder": "Qualidade",
            "expression": "IF(SELECTEDVALUE('DimCrime'[comparacao_limitada], FALSE()), \"Cobertura interrompida\", \"Contagem comparável\")",
            "lineageTag": "27f1e46b-6a4a-4778-882e-a6a3eecb095e"
          }
        ],
        "partitions": [
          {
            "name": "FatoCrimes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = BaseMensal,",
                "    Bairro = Table.NestedJoin(Fonte, {\"bairro\"}, DimBairro, {\"bairro\"}, \"DimBairro\", JoinKind.LeftOuter),",
                "    BairroExpandido = Table.ExpandTableColumn(Bairro, \"DimBairro\", {\"bairro_id\"}),",
                "    Crime = Table.NestedJoin(BairroExpandido, {\"categoria_original\"}, DimCrime, {\"categoria_original\"}, \"DimCrime\", JoinKind.LeftOuter),",
                "    CrimeExpandido = Table.ExpandTableColumn(Crime, \"DimCrime\", {\"crime_id\"}),",
                "    Fato = Table.SelectColumns(CrimeExpandido, {\"data_mes\", \"bairro_id\", \"crime_id\", \"crimes\", \"registros_origem\"}),",
                "    Tipos = Table.TransformColumnTypes(Fato, {{\"data_mes\", type date}, {\"bairro_id\", Int64.Type}, {\"crime_id\", Int64.Type}, {\"crimes\", Int64.Type}, {\"registros_origem\", Int64.Type}})",
                "in Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
