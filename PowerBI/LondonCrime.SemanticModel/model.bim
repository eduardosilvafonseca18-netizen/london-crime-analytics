          {
            "name": "quantidade_crimes",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "6fa985cd-1d0c-4d1c-850e-354306f78919",
            "sourceColumn": "crimes",
            "summarizeBy": "none"
          },
          {
            "name": "registros_origem",
            "dataType": "int64",
            "isHidden": true,
