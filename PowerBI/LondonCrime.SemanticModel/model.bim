        "lineageTag": "cbc41450-f127-41cf-ab39-84c8a18e9f8e",
        "partitions": [
          {
            "name": "DimCrime",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Texto = \"crime_id,categoria_original,categoria,violencia_pessoa,comparacao_limitada#(lf)1,Burglary,Invasão e furto em imóvel,false,false#(lf)2,Criminal Damage,Dano ao patrimônio,false,false#(lf)3,Drugs,Drogas,false,false#(lf)4,Fraud or Forgery,Fraude ou falsificação,false,true#(lf)5,Other Notifiable Offences,Outras infrações,false,false#(lf)6,Robbery,Roubo,false,false#(lf)7,Sexual Offences,Crimes sexuais,false,true#(lf)8,Theft and Handling,Furto e receptação,false,false#(lf)9,Violence Against the Person,Violência contra a pessoa,true,false#(lf)\",",
                "    Csv = Csv.Document(Text.ToBinary(Texto, TextEncoding.Utf8), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"crime_id\", Int64.Type}, {\"categoria_original\", type text}, {\"categoria\", type text}, {\"violencia_pessoa\", type logical}, {\"comparacao_limitada\", type logical}}, \"en-US\")",
                "in",
                "    Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "FatoCrimes",
        "columns": [
          {
            "name": "data_mes",
            "annotations": [
              {
